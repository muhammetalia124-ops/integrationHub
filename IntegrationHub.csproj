<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntegrationHub</RootNamespace>
    <AssemblyName>IntegrationHub</AssemblyName>
    <UserSecretsId>5ebb5465-c59f-4c01-963e-d928229993af</UserSecretsId>
    <RollForward>Major</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Controllers\**\*.cs" />
    <Compile Include="Middlewares\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Domain\IntegrationHub.Domain.csproj" />
    <ProjectReference Include="Infrastructure\IntegrationHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
